[Unit]
Description=SwitchBot Backend API
After=network.target

[Service]
Type=simple
User=koki
Group=koki
WorkingDirectory=/home/koki/workspace/switchbot/backend
Environment="PATH=/home/koki/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/koki/.local/bin/uv run uvicorn src.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
